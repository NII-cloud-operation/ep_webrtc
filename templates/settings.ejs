<% if (!audio_hard_disabled) { %>
  <p>
    <input type="checkbox" id="options-audioenabledonstart" ></input>
    <label for="options-audioenabledonstart" data-l10n-id="ep_webrtc_settings_audioenabledonstart">Audio On At Start</label>
  </p>
<% } %>
<% if (!video_hard_disabled) { %>
  <p>
    <input type="checkbox" id="options-videoenabledonstart" ></input>
    <label for="options-videoenabledonstart" data-l10n-id="ep_webrtc_settings_videoenabledonstart">Video On At Start</label>
  </p>
  <p>
    <input type="checkbox" id="options-backgroundblur">
    <label for="options-backgroundblur" data-l10n-id="ep_webrtc_backgroundblur">Blur camera background</label>
  </p>
<% } %>
